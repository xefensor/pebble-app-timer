{
  "name": "pebble-app-timer",
  "version": "0.3.1",
  "author": "Xef",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A standalone stock PebbleOS timer with native alarms and activity sharing.",
  "dependencies": {
    "pebble-activities": "file:vendor/pebble-activities-0.2.0.tgz"
  },
  "scripts": {
    "test": "python3 scripts/test.py",
    "build": "python3 scripts/build.py"
  },
  "pebble": {
    "displayName": "Timer",
    "uuid": "50e9ef12-a5ab-4369-a3b5-3447bfba5151",
    "sdkVersion": "3",
    "projectType": "native",
    "targetPlatforms": [
      "emery"
    ],
    "enableMultiJS": true,
    "watchapp": {
      "watchface": false
    },
    "resources": {
      "media": []
    },
    "usesPermissions": [],
    "messageKeys": {
      "ACTIVITY_SCHEMA_VERSION": 1000,
      "ACTIVITY_RUN": 1001,
      "ACTIVITY_REVISION": 1002,
      "ACTIVITY_STATE": 1003,
      "ACTIVITY_KIND": 1004,
      "ACTIVITY_CLOCK": 1005,
      "ACTIVITY_NAME": 1006,
      "ACTIVITY_MAIN": 1007,
      "ACTIVITY_FOOTER": 1008,
      "ACTIVITY_OBSERVED_AT": 1009,
      "ACTIVITY_VALID_UNTIL": 1010,
      "ACTIVITY_DEADLINE": 1011,
      "ACTIVITY_DURATION": 1012,
      "ACTIVITY_CLOCK_AT": 1013,
      "ACTIVITY_ACCEPTED_RUN": 1014,
      "ACTIVITY_ACCEPTED_REVISION": 1015,
      "ACTIVITY_ERROR": 1016,
      "ACTIVITY_REQUEST": 1017,
      "ACTIVITY_PRIVATE": 1018,
      "ACTIVITY_LAST_REVISION": 1019,
      "ACTIVITY_PUBLISH_SESSION": 1020,
      "ACTIVITY_SLOT": 1021,
      "ACTIVITY_TOTAL_DURATION": 1022
    },
    "plugin": {
      "description": "The latest state reported by this watch's Timer app. The native timer owns its alarm; this source only shares state.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "activity",
          "supportsMultiple": true,
          "suggestedRefreshIntervalSec": 30,
          "items": [
            "session",
            "card"
          ],
          "properties": {
            "schema_version": [
              "numericValue"
            ],
            "kind": [
              "shortText"
            ],
            "state": [
              "shortText"
            ],
            "clock": [
              "shortText"
            ],
            "revision": [
              "numericValue"
            ],
            "name": [
              "longText"
            ],
            "main": [
              "longText"
            ],
            "footer": [
              "longText"
            ],
            "observed_at": [
              "timestamp"
            ],
            "valid_until": [
              "timestamp"
            ],
            "deadline": [
              "timestamp"
            ],
            "duration": [
              "numericValue"
            ],
            "clock_at": [
              "timestamp"
            ],
            "private": [
              "boolean"
            ],
            "unconfirmed": [
              "boolean"
            ],
            "caption": [
              "longText"
            ],
            "show_terminal": [
              "boolean"
            ],
            "artwork": [
              "image",
              "icon"
            ],
            "main_type": [
              "shortText"
            ],
            "main_label": [
              "longText"
            ],
            "main_text": [
              "longText"
            ],
            "main_value": [
              "numericValue"
            ],
            "main_observed_at": [
              "timestamp"
            ],
            "main_valid_until": [
              "timestamp"
            ],
            "main_retain": [
              "boolean"
            ],
            "main_estimated": [
              "boolean"
            ],
            "main_clock": [
              "shortText"
            ],
            "main_base": [
              "numericValue"
            ],
            "main_anchor": [
              "timestamp"
            ],
            "main_running": [
              "boolean"
            ],
            "support_type": [
              "shortText"
            ],
            "support_label": [
              "longText"
            ],
            "support_text": [
              "longText"
            ],
            "support_value": [
              "numericValue"
            ],
            "support_observed_at": [
              "timestamp"
            ],
            "support_valid_until": [
              "timestamp"
            ],
            "support_retain": [
              "boolean"
            ],
            "support_estimated": [
              "boolean"
            ],
            "support_clock": [
              "shortText"
            ],
            "support_base": [
              "numericValue"
            ],
            "support_anchor": [
              "timestamp"
            ],
            "support_running": [
              "boolean"
            ],
            "meter_kind": [
              "shortText"
            ],
            "meter_source": [
              "shortText"
            ],
            "meter_min": [
              "numericValue"
            ],
            "meter_max": [
              "numericValue"
            ]
          }
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xefensor/pebble-app-timer.git"
  }
}
