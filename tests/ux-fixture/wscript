top = '.'
out = 'build'
from os import environ
def options(ctx): ctx.load('pebble_sdk')
def configure(ctx): ctx.load('pebble_sdk')
def build(ctx):
    ctx.load('pebble_sdk')
    cached = ctx.env
    binaries = []
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.env.DEFINES = [value for value in ctx.env.DEFINES if not value.startswith('UX_FIXTURE_MODE=')]
        ctx.env.append_unique('DEFINES', 'UX_FIXTURE_MODE=' + environ.get('UX_FIXTURE_MODE', '0'))
        ctx.set_group(ctx.env.PLATFORM_NAME)
        elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), includes=['../../node_modules'], target=elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': elf})
    ctx.env = cached
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries)
